<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:descendantFocusability="blocksDescendants"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="28dp">

            <!-- ================= HEADER ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvHeaderTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed"
                        android:letterSpacing="0.1"
                        android:text="iTANTRA"
                        android:textColor="@color/text_white"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHeaderSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.16"
                        android:text="@string/app_subtitle"
                        android:textAllCaps="true"
                        android:textColor="@color/text_faint"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnOpenModels"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_button_rounded"
                        android:backgroundTint="@color/bg_surface_raised"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="9dp"
                        android:text="MODELS"
                        android:textAllCaps="true"
                        android:textColor="@color/comm_green"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- ================= THIS DEVICE ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_surface_chip"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.14"
                        android:text="THIS DEVICE"
                        android:textAllCaps="true"
                        android:textColor="@color/text_faint"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvNodeId"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:fontFamily="monospace"
                        android:text="ITN-UNKNOWN"
                        android:textColor="@color/comm_green"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Connection summary from real backend -->
                <TextView
                    android:id="@+id/tvConnSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/cta_offline"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnScanConnect"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_rounded"
                        android:backgroundTint="@color/bg_surface_raised"
                        android:gravity="center"
                        android:text="@string/connect_label"
                        android:textAllCaps="true"
                        android:textColor="@color/comm_green"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinnerTransport"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_button_rounded"
                        android:backgroundTint="@color/comm_green_dim"
                        android:popupBackground="@drawable/bg_popup"
                        android:paddingHorizontal="14dp"
                        android:dropDownVerticalOffset="4dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ================= RADAR + ACTION ================= -->
            <FrameLayout
                android:id="@+id/radarContainer"
                android:layout_width="match_parent"
                android:layout_height="272dp"
                android:layout_marginTop="12dp"
                android:clipChildren="false">

                <View
                    android:id="@+id/radarRingOuter"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="14dp"
                    android:alpha="0.3"
                    android:background="@drawable/ring_outer" />

                <View
                    android:id="@+id/radarRingMid"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="14dp"
                    android:alpha="0.5"
                    android:background="@drawable/ring_mid" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPtt"
                    android:layout_width="132dp"
                    android:layout_height="132dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/status_node"
                    android:backgroundTint="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:stateListAnimator="@null"
                    android:text="@string/ptt_hold_to_talk"
                    android:textColor="@color/bg_black"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:cornerRadius="66dp"
                    app:icon="@drawable/ic_mic"
                    app:iconGravity="textStart"
                    app:iconSize="20dp"
                    app:iconTint="@color/bg_black"
                    app:rippleColor="@android:color/transparent" />

                <View
                    android:id="@+id/statusNodeGlow"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="14dp"
                    android:alpha="0.15"
                    android:background="@drawable/status_node" />

                <!-- Language dropdown — top-left above PTT -->
                <Spinner
                    android:id="@+id/spinnerLanguage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_button_rounded"
                    android:backgroundTint="@color/bg_surface_raised"
                    android:popupBackground="@drawable/bg_popup"
                    android:paddingHorizontal="12dp"
                    android:dropDownVerticalOffset="4dp" />

                <!-- Incoming message circle (history icon) — top-right above PTT -->
                <FrameLayout
                    android:id="@+id/btnInfo"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_button_rounded"
                    android:backgroundTint="@color/bg_surface_raised"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/incoming">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_history"
                        app:tint="@color/comm_green" />
                </FrameLayout>
            </FrameLayout>

            <!-- Bottom buttons row — below radar, above READY (own layer) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/btnSttInfo"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_button_rounded"
                    android:backgroundTint="@color/bg_surface_raised"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/incoming">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_info"
                        app:tint="@color/comm_green" />
                </FrameLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <FrameLayout
                    android:id="@+id/btnAlert"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_button_rounded"
                    android:backgroundTint="@color/bg_surface_raised"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/emergency_sos">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_emergency"
                        app:tint="@color/comm_red" />
                </FrameLayout>
            </LinearLayout>

            <!-- Pipeline state / status (plain text) -->
            <TextView
                android:id="@+id/tvStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:letterSpacing="0.18"
                android:text="@string/standby_ready"
                android:textAllCaps="true"
                android:textColor="@color/text_white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Incoming message details (second card; shown by bottom-left info button) -->
            <TextView
                android:id="@+id/tvIncomingDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_surface_chip"
                android:padding="12dp"
                android:text="@string/no_message"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Latency summary (real) -->
            <LinearLayout
                android:id="@+id/perfChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_surface_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.14"
                    android:text="E2E LATENCY"
                    android:textAllCaps="true"
                    android:textColor="@color/text_faint"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvPerfSummary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="@string/latency_placeholder"
                    android:textColor="@color/text_white"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvLatencyMetrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_surface_chip"
                android:padding="12dp"
                android:text="@string/latency_placeholder"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- ================= YOUR MESSAGE (first card) ================= -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:letterSpacing="0.14"
                android:text="@string/your_voice"
                android:textAllCaps="true"
                android:textColor="@color/comm_green"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvLastSttText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_surface_chip"
                android:padding="12dp"
                android:text="@string/awaiting_voice"
                android:textColor="@color/text_muted"
                android:textSize="16sp" />

            <!-- ================= NETWORK MINI STATS ================= -->
            <TextView
                android:id="@+id/tvNetworkStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_surface_chip"
                android:padding="10dp"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <!-- ================= EMERGENCY SOS ================= -->
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>