<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ITantra" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/comm_green</item>
        <item name="colorOnPrimary">@color/bg_black</item>
        <item name="colorSecondary">@color/comm_amber</item>
        <item name="colorOnSecondary">@color/bg_black</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_white</item>
        <item name="android:colorBackground">@color/bg_black</item>
        <item name="colorOnBackground">@color/text_white</item>
        <item name="android:statusBarColor">@color/bg_black</item>
        <item name="android:navigationBarColor">@color/bg_black</item>
        <item name="android:windowBackground">@color/bg_black</item>
        <item name="colorControlNormal">@color/text_muted</item>
        <item name="android:alertDialogTheme">@style/Theme.ITantra.Dialog</item>
        <item name="materialAlertDialogTheme">@style/Theme.ITantra.Dialog</item>
    </style>

    <style name="Theme.ITantra.Dialog" parent="ThemeOverlay.Material3.Dialog">
        <item name="android:windowBackground">@color/bg_surface</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_white</item>
        <item name="android:titleTextColor">@color/text_white</item>
        <item name="android:textColorPrimary">@color/text_white</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/Widget.ITantra.DialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/Widget.ITantra.DialogButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/Widget.ITantra.DialogButton</item>
    </style>

    <style name="Widget.ITantra.DialogButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">@color/comm_green</item>
    </style>
</resources>